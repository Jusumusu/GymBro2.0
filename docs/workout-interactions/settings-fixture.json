[
  {
    "title": "Backup & Data",
    "html": "<section class=\"panel backup-settings\"><p class=\"eyebrow\">YOUR PROGRESS, PROTECTED</p><h2>Backup &amp; Data</h2><span class=\"badge\">Saved on this device</span><h3>No verified backup yet</h3><p>Local storage is your journal. Keep a separate backup file to protect it.</p><div class=\"stack\"><button type=\"button\" class=\"primary\" data-action=\"export-json\">Export backup</button><button type=\"button\" class=\"secondary\" data-action=\"import-dialog\">Restore from backup</button><button type=\"button\" class=\"secondary\" data-action=\"verify-backup\">Verify a saved backup</button><button type=\"button\" class=\"quiet\" data-action=\"backup-recovery-dialog\">Recover journal before last restore</button><button type=\"button\" class=\"quiet\" data-action=\"export-csv\">Export workout CSV</button><button type=\"button\" class=\"quiet\" data-action=\"persist\">Request persistent device storage</button></div><form id=\"backup-reminder-form\"><label class=\"field\"><span>Remind me to back up</span><select name=\"interval\"><option value=\"never\" selected=\"\">Never</option><option value=\"weekly\">Weekly</option><option value=\"monthly\">Monthly</option><option value=\"quarterly\">Every three months</option></select></label><button class=\"secondary\" type=\"submit\">Save reminder</button><p class=\"muted\">Reminders appear while Gym Bro is open and respect Notifications. No cloud backup or device sync is connected.</p></form></section>"
  },
  {
    "title": "Appearance",
    "html": "<section class=\"panel upgrade-settings\"><h2>Appearance</h2><p class=\"muted\">Choose your display preference. Theme changes save immediately; your training records stay as recorded.</p><form id=\"appearance-form\"><div class=\"form-grid\"><label class=\"field\"><span>Appearance</span><select name=\"theme\"><option value=\"dark\" selected=\"\">Dark Mode</option><option value=\"light\">Light Mode</option><option value=\"system\">System Default</option></select></label><label class=\"field\"><span>Coach style</span><select name=\"style\"><option value=\"supportive\">Supportive</option><option value=\"analytical\" selected=\"\">Direct &amp; analytical</option><option value=\"motivational\">Motivational</option><option value=\"educational\">Educational</option><option value=\"minimal\">Minimal</option></select></label></div><label class=\"toggle\"><input name=\"haptics\" type=\"checkbox\">Optional haptic feedback where supported</label><button class=\"primary\" type=\"submit\">Save appearance</button></form><p id=\"appearance-status\" class=\"status-line\" role=\"status\"></p></section>"
  },
  {
    "title": "Calendar Preferences",
    "html": "<section class=\"panel calendar-preferences\"><h2>Calendar Preferences</h2><form id=\"calendar-preferences-form\"><label class=\"field\"><span>Start of Week</span><select name=\"weekStartsOn\"><option value=\"0\">Sunday</option><option value=\"1\" selected=\"\">Monday</option></select><small>Sunday–Saturday or Monday–Sunday. Dates stay unchanged; weekly summaries use your choice.</small></label><button class=\"primary\" type=\"submit\">Save calendar preferences</button></form></section>"
  },
  {
    "title": "Training tools",
    "html": "<section class=\"panel training-tools\"><h2>Training tools</h2><div class=\"actions\"><button type=\"button\" class=\"secondary\" data-action=\"plates-dialog\">Plate calculator</button><button type=\"button\" class=\"secondary\" data-action=\"recovery-dialog\">Recovery check-in</button><a class=\"secondary\" href=\"#goals\">Personal goals</a><a class=\"secondary\" href=\"#calendar\">Training calendar</a></div></section>"
  },
  {
    "title": "Notifications",
    "html": "<section class=\"panel notification-settings\"><h2>Notifications</h2><form id=\"notifications-form\"><label class=\"toggle\"><input type=\"checkbox\" name=\"enabled\" role=\"switch\">Workout Notifications <strong data-notification-enabled=\"\">Off</strong></label><p class=\"muted\">Turning this off suppresses reminders and keeps every schedule and reminder preference.</p><label class=\"field\"><span>Default reminder timing</span><select name=\"defaultMinutes\"><option value=\"0\">At workout time</option><option value=\"15\">15 minutes before</option><option value=\"30\" selected=\"\">30 minutes before</option><option value=\"60\">1 hour before</option><option value=\"1440\">1 day before</option></select></label><p class=\"notification-status\" id=\"notification-permission-status\">Browser permission: Blocked. You can change this in browser or device settings; in-app reminders still work.</p><button type=\"button\" class=\"secondary\" data-action=\"request-notification-permission\">Allow browser notifications</button><p class=\"notification-status\">Reminders require this app to remain open and active. Closed or suspended apps cannot deliver reliable scheduled reminders on this static site. Reliable closed-app push needs a separate notification backend.</p><p class=\"muted\">Uses your device’s local time. A clock time skipped by daylight saving has no reminder that day. Schedules remain on their chosen dates.</p></form></section>"
  },
  {
    "title": "Workout preferences",
    "html": "<section class=\"panel\"><h2>Workout preferences</h2><form id=\"workout-preferences-form\"><label class=\"toggle\"><input type=\"checkbox\" name=\"keepScreenAwake\" checked=\"\">Keep Screen Awake</label><label class=\"toggle\"><input type=\"checkbox\" name=\"restCountdownSound\" checked=\"\">Final five-second countdown sounds</label><label class=\"toggle\"><input type=\"checkbox\" name=\"restCompletionSound\" checked=\"\">Rest completion sound</label><label class=\"toggle\"><input type=\"checkbox\" name=\"restVibration\" checked=\"\">Rest completion vibration</label><p class=\"muted\">Keep Screen Awake prevents automatic screen sleep during an active workout when supported. Battery and device restrictions may release it.</p><p class=\"muted\" data-wake-status=\"\" role=\"status\">Ready for your next active workout.</p><p class=\"muted\">Sounds work while the app is visible after an interaction. Locked or background alerts are not guaranteed. Rest vibration also requires Optional haptic feedback in Appearance.</p><p class=\"muted\" data-rest-audio-status=\"\" role=\"status\">Sounds need a workout interaction to become ready.</p><button type=\"submit\" class=\"secondary\">Save workout preferences</button></form></section>"
  },
  {
    "title": "Training profile",
    "html": "<section class=\"panel\"><h2>Training profile</h2><form id=\"profile-form\"><label class=\"field\"><span>Your name</span><input name=\"name\" maxlength=\"60\" autocomplete=\"given-name\" value=\"\" placeholder=\"What should we call you?\"></label><label class=\"field\"><span>Primary goal</span><select name=\"goal\"><option value=\"hypertrophy\" selected=\"\">Build muscle</option><option value=\"strength\">Get stronger</option><option value=\"balanced\">Muscle &amp; strength</option><option value=\"recomposition\">Body recomposition</option><option value=\"fatloss\">Preserve muscle in fat loss</option><option value=\"endurance\">Muscular endurance</option><option value=\"fitness\">General fitness</option></select></label><div class=\"form-grid\"><label class=\"field\"><span>Experience</span><select name=\"experience\"><option value=\"beginner\" selected=\"\">Getting started</option><option value=\"intermediate\">Training regularly</option><option value=\"experienced\">Experienced lifter</option></select></label><label class=\"field\"><span>Sessions per week</span><input name=\"days\" type=\"number\" min=\"1\" max=\"7\" step=\"1\" required=\"\" value=\"3\"></label><label class=\"field\"><span>Session length (minutes)</span><input name=\"minutes\" type=\"number\" min=\"15\" max=\"150\" step=\"5\" required=\"\" value=\"45\"></label><label class=\"field\"><span>Training structure</span><select name=\"split\"><option value=\"full\" selected=\"\">Full body</option><option value=\"upperlower\">Upper / lower</option><option value=\"ppl\">Push / pull / legs</option><option value=\"custom\">Custom / manual</option></select></label><label class=\"field\"><span>Display units</span><select name=\"unit\" data-current-unit=\"kg\"><option value=\"kg\" selected=\"\">Kilograms · centimeters</option><option value=\"lb\">Pounds · inches</option></select></label><label class=\"field\"><span>Equipment increment (in selected units)</span><input name=\"increment\" data-canonical=\"2.5\" type=\"number\" min=\"0.25\" max=\"50\" step=\"any\" required=\"\" value=\"2.5\"><small>Smallest available total-load increment; dumbbell loads are per dumbbell.</small></label></div><fieldset><legend>Available equipment</legend><div class=\"chips\"><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"barbell\">Barbell</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"dumbbell\" checked=\"\">Dumbbell</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"cable\">Cable</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"machine\">Machines (all)</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"bodyweight\" checked=\"\">Bodyweight</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"smith\">Smith machine</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"plate-loaded\">Plate-loaded machine</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"selectorized\">Selectorized machine</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"kettlebell\">Kettlebell</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"ez-bar\">EZ bar</label><label class=\"check-chip\"><input name=\"equipment\" type=\"checkbox\" value=\"trap-bar\">Trap bar</label></div></fieldset><details><summary>Personalize a little more <span>Optional</span></summary><div class=\"form-grid\"><label class=\"field\"><span>Secondary goal</span><select name=\"secondaryGoal\"><option value=\"\">None</option><option value=\"hypertrophy\">Build muscle</option><option value=\"strength\">Get stronger</option><option value=\"balanced\">Muscle &amp; strength</option><option value=\"recomposition\">Body recomposition</option><option value=\"fatloss\">Preserve muscle in fat loss</op